enum Status {
  Uninitialized
  InProgress
  Completed

  @@map("status")
}

model Entry {
  id             Int      @id @default(autoincrement())
  url            String
  title          String
  description    String?
  status         Status   @default(Uninitialized)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([url])
  @@map("entry")
}
